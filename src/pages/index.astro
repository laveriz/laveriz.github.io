---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main>
		<video autoplay loop muted playsinline aria-label="main hero video">
			<source src="/main-hero.mp4" type="video/mp4" />
		</video>
	</main>
</Layout>

<style>
	main {
		height: 100vh;
		display: flex;
		justify-content: center;
		align-items: center;
	}
	video {
		width: 100%;
		max-width: 960px;
		max-height: 80vh;
	}
</style>
