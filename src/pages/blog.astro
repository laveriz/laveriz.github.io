---
import Layout from '../layouts/Layout.astro';
import PageContent from '../components/PageContent.astro';
---

<Layout title="Blog">
	<PageContent>
		<h1>Blog</h1>
		<p>This is where I will post about my journey as I build applications.</p>
		<ul class="post-list">
			<li>
				<a href="/posts/hello/">
					<i class="bi bi-arrow-right-short"></i>
					Hello World
				</a>
			</li>
		</ul>
	</PageContent>
</Layout>

<style>
	.post-list {
		list-style: none;
		padding-left: 0;
		margin-top: 1.5rem;
	}

	.post-list li a {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		padding: 0.4rem 0;
		color: #c9b8e8;
		transition:
			color 0.2s,
			gap 0.2s;
	}

	.post-list li a:hover {
		color: #e8dcff;
		gap: 0.5rem;
	}

	.post-list li a i {
		font-size: 1.2rem;
		transition: transform 0.2s;
	}

	.post-list li a:hover i {
		transform: translateX(3px);
	}
</style>
